# Copy to .env.local and fill in your values (never commit .env.local)

# ── Microsoft Clarity ──────────────────────────────────────────────────────────
# Project ID from https://clarity.microsoft.com → Settings → Overview
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ── Google Analytics 4 — GARV AI LABS ───────────────────────────────────────────
# Stream ID: 15599721589 · Measurement ID: G-ZZ9B7HE6T7 (configured in code)
# Optional override:
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-ZZ9B7HE6T7
# NEXT_PUBLIC_GA_STREAM_ID=15599721589

# ── Development (optional) ─────────────────────────────────────────────────────
# Set to "true" to enable Clarity + GA on localhost
# NEXT_PUBLIC_ANALYTICS_ENABLE_DEV=true
